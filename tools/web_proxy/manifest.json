{
  "id": "web_proxy",
  "name": "网页代理",
  "description": "基于 Rammerhead 的用户隔离完整 Web Proxy，支持登录网站的独立会话。（大部分网页显示不正常）",
  "version": "0.1.0",
  "enabled": true,
  "category": "network",
  "icon": {
    "type": "lucide",
    "name": "globe"
  },
  "displayMode": "fullscreen",
  "entry": {
    "frontend": "frontend/index.tsx",
    "backend": "backend/router.py"
  },
  "api": {
    "prefix": "/web-proxy"
  },
  "widgets": [],
  "dependencies": {},
  "permissions": {
    "filesystem": true,
    "network": true,
    "longRunningTask": true,
    "userData": true
  }
}
