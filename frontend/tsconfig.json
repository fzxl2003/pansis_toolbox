{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "react": ["node_modules/@types/react"],
      "react/jsx-runtime": ["node_modules/@types/react/jsx-runtime"],
      "react-dom/client": ["node_modules/@types/react-dom/client"],
      "lucide-react": ["node_modules/lucide-react/dist/lucide-react.d.ts"],
      "@xterm/xterm": ["node_modules/@xterm/xterm/typings/xterm.d.ts"],
      "@xterm/addon-fit": ["node_modules/@xterm/addon-fit/typings/addon-fit.d.ts"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src", "../tools/*/frontend/**/*.tsx", "../tools/*/frontend/**/*.ts"],
  "references": []
}
