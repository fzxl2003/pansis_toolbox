{
  "id": "ssh_workspace",
  "name": "SSH 工作台",
  "description": "个人 SSH 服务器、网页终端、screen 会话、命令模板和定时任务工作台。",
  "version": "1.0.0",
  "enabled": true,
  "category": "ops",
  "icon": "terminal",
  "displayMode": "flexible",
  "entry": {
    "frontend": "frontend/index.tsx",
    "backend": "backend/router.py"
  },
  "api": {
    "prefix": "/api/tools/ssh-workspace"
  },
  "widgets": [],
  "dependencies": {
    "paramiko": ">=3.0.0",
    "cryptography": ">=41.0.0"
  },
  "permissions": {
    "filesystem": false,
    "network": true,
    "longRunningTask": true,
    "userData": true
  }
}
